{
  "name": "a2asearch-mcp",
  "mcpName": "io.github.tadas-github/a2asearch-mcp",
  "version": "1.2.0",
  "description": "Find AI agents and MCP servers, inspect capabilities and get documented setup instructions via A2ASearch",
  "main": "index.js",
  "type": "module",
  "bin": {
    "a2asearch-mcp": "index.js",
    "a2asearch": "cli.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check cli.js && node --check lib/catalog.js && node --check lib/setup.js && node --check lib/tools.js",
    "prepack": "npm run check && npm test",
    "smoke:live": "node scripts/smoke-live.js"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "mcp-server",
    "search",
    "directory",
    "a2asearch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tadas-github/a2asearch-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "cli.js",
    "lib/",
    "server.json",
    "icon.png",
    "LICENSE",
    "README.md"
  ]
}
